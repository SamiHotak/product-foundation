# backend/.env — your PRIVATE settings. Never commit this file (it is in .gitignore).
#
# With Docker (make dev) you only need the Google and Stripe lines below; everything else is
# set in deploy/docker-compose.dev.yml. Values in docker-compose win over this file.
# After changing this file: make restart s=backend  (and s=worker)

# --- Google sign-in (optional; the button is hidden when these are empty) ---
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web application)
# Authorized redirect URI: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Stripe (optional; TEST keys only on your laptop). See docs/BILLING.md ---
# Empty = the pretend checkout (local only). Stripe dashboard -> Developers -> API keys.
STRIPE_SECRET_KEY=
# Printed by `make stripe-listen` ("Your webhook signing secret is whsec_...").
STRIPE_WEBHOOK_SECRET=
# STRIPE_PREFIX=foundation        # each product its own prefix (products share one Stripe account)
# STRIPE_AUTOMATIC_TAX=false      # true = Stripe Tax calculates VAT (set it up in Stripe first)

# --- AI (optional locally: without a key a free pretend model answers) ---
# See docs/FILES_AND_AI.md. Set a monthly budget limit in the OpenAI dashboard first!
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://eu.api.openai.com/v1   # EU data residency (eligible projects only)
# LLM_MODELS={"summarize": "gpt-6.1-sol"}         # another model for a task
# LLM_ENABLED=true                  # false = every AI call stops (admins also have "Pause AI")
# Langfuse: traces with tokens and cost per AI call (cloud.langfuse.com -> project -> API keys)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com       # EU region (US: https://us.cloud.langfuse.com)
# LLM_TRACE_CONTENT=false           # true = also send the texts to Langfuse (update the privacy policy!)

# --- Files (locally SeaweedFS in Docker is already set up; production: Hetzner) ---
# S3_ENDPOINT=https://fsn1.your-objectstorage.com
# S3_REGION=fsn1
# S3_BUCKET=your-product-files
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_PUBLIC_URL=                    # empty in production (browsers go straight to Hetzner)
# FILES_MAX_BYTES=26214400          # 25 MB per file
# CLAMAV_HOST=                      # virus scan (clamd). Empty = no scan

# --- Demo and admin (defaults shown; the dev compose turns the demo on) ---
# DEMO_ENABLED=false
# DEMO_AI_PER_HOUR=10               # AI summaries per demo visitor per hour
# IMPERSONATION_MINUTES=60          # how long an admin may view the app as a user

# --- Email provider (optional locally: Mailpit catches everything) ---
# EMAIL_PROVIDER=smtp             # smtp | resend | postmark
# EMAIL_API_KEY=                  # Resend: re_...  Postmark: server token
# EMAIL_FROM=Your Product <no-reply@your-domain.com>   # a domain you verified at the provider
# EMAIL_REPLY_TO=support@your-domain.com
# EMAIL_FOOTER_ADDRESS=Your Company, Street 1, 41061 Mönchengladbach, Germany
# EMAIL_BRAND_COLOR=#244ba6

# --- Only when running the backend OUTSIDE Docker (e.g. pytest in your editor) ---
# DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/app
# REDIS_URL=redis://localhost:6379/0
# SMTP_HOST=localhost

# --- Optional: team, API keys and privacy (defaults shown) ---
# INVITE_DAYS=7                     # how long an invite link works
# INVITES_PER_ORG_PER_HOUR=30
# API_KEY_PREFIX=pf                 # keys look like pf_...
# API_KEY_REQUESTS_PER_MINUTE=600
# DELETION_GRACE_DAYS=14            # time to cancel deleting an account or workspace
# EXPORT_RETENTION_DAYS=7           # data export ZIPs are deleted after this
# AUDIT_RETENTION_DAYS=365

# --- Optional: cookie-less visitor statistics (off by default) ---
# ANALYTICS_PROVIDER=plausible          # none | plausible | umami
# ANALYTICS_HOST=https://plausible.io   # Umami Cloud: https://cloud.umami.is
# ANALYTICS_SITE=your-domain.com        # Plausible: your domain. Umami: the website id
