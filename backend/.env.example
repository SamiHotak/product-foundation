# backend/.env — your PRIVATE settings. Never commit this file (it is in .gitignore).
#
# With Docker (make dev) you only need the Google lines below; everything else is set in
# deploy/docker-compose.dev.yml. Values in docker-compose win over this file.

# --- Google sign-in (optional; the button is hidden when these are empty) ---
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web application)
# Authorized redirect URI: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Only when running the backend OUTSIDE Docker (e.g. pytest in your editor) ---
# DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/app
# REDIS_URL=redis://localhost:6379/0
# SMTP_HOST=localhost
