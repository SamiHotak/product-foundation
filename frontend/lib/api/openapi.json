  "components": {
    "schemas": {
      "AuthProviders": {
        "properties": {
          "password": {
            "type": "boolean",
            "title": "Password",
            "default": true
          },
          "google": {
            "type": "boolean",
            "title": "Google"
          }
        },
        "type": "object",
        "required": [
          "google"
        ],
        "title": "AuthProviders",
        "description": "Which sign-in options are switched on."
      },
      "DependencyCheck": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "error"
            ],
            "title": "Status"
          },
          "latency_ms": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Latency Ms"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
