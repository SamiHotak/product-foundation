# Production settings for the server: copy this file to /opt/app/.env and fill it in.
#   sudo nano /opt/app/.env      then      chmod 600 /opt/app/.env
# NEVER commit the real file (it is git-ignored). deploy/server-setup.md explains every step.
# Make secrets with:   openssl rand -hex 32      (hex only: no special characters to escape)
# Values with spaces need double quotes: EMAIL_FROM="My App <no-reply@my-domain.com>"

# --- Server and domain -------------------------------------------------------------------
DOMAIN=my-domain.com
ACME_EMAIL=you@my-domain.com
# Where the images live (GitHub Container Registry). Lowercase! The deploy sets IMAGE_TAG itself.
IMAGE_PREFIX=ghcr.io/samihotak/product-foundation

# --- Secrets (make each with: openssl rand -hex 32) ---------------------------------------
SECRET_KEY=
# Password of the LIMITED database user the app runs as ("app_rt": can read and write rows, nothing
# else). ./deploy.sh creates that user with this password. Hex only. To change it, see
# docs/SECURITY.md ("Rotating secrets").
POSTGRES_APP_PASSWORD=
REDIS_PASSWORD=
# (The Postgres ADMIN password is NOT in this file, on purpose: it is the file
# /opt/app/secrets/postgres_admin_password, see deploy/server-setup.md step 10.
# Never add POSTGRES_PASSWORD or MIGRATION_DATABASE_URL here: ./deploy.sh refuses to deploy.)
# (The backup passphrase and the backup bucket keys are NOT in this file, on purpose: the app
# containers read this whole file, so a hacked app would find the backup keys. They live in
# /opt/app/.env.backup, see .env.backup.example.)

# --- Product ------------------------------------------------------------------------------
# Must equal name in frontend/config/product.ts (shown in emails).
APP_NAME=Foundation
DEMO_ENABLED=false

# --- Email (Resend or Postmark) -----------------------------------------------------------
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
EMAIL_FROM="Foundation <no-reply@my-domain.com>"
EMAIL_REPLY_TO=support@my-domain.com
EMAIL_FOOTER_ADDRESS=

# --- File storage (Hetzner Object Storage, Germany). Run `make storage-setup` once ----------
S3_ENDPOINT=https://fsn1.your-objectstorage.com
S3_REGION=fsn1
S3_BUCKET=my-app-files
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Same address as S3_ENDPOINT, only the origin (used by the security headers):
S3_ORIGIN=https://fsn1.your-objectstorage.com

# --- Billing (Stripe: live keys here, test keys only in test mode) -------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PREFIX=foundation
STRIPE_AUTOMATIC_TAX=false

# --- AI (optional) -------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# --- Google sign-in (optional) -------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Error reports (optional). Backend DSN here; the website's DSN is a GitHub variable ------
SENTRY_DSN=

# --- Website statistics (optional, cookie-less) ---------------------------------------------
ANALYTICS_PROVIDER=none
ANALYTICS_HOST=
ANALYTICS_SITE=
