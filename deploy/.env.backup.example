# Backup settings: copy this file to /opt/app/.env.backup and fill it in.
#   nano /opt/app/.env.backup      then      chmod 600 /opt/app/.env.backup
# It is SEPARATE from .env on purpose: the app containers read .env, but never this file. If the
# app is ever hacked, the attacker still cannot open or delete your backups.
# Only backup.sh and restore-test.sh read it (on the server, outside the app containers).
# NEVER commit the real file (it is git-ignored). Values with spaces need double quotes.

# Encrypts the database backups (make it with: openssl rand -hex 32). If you lose it, the
# backups are useless: keep a copy in your password manager, NOT only on the server.
BACKUP_PASSPHRASE=

# A SEPARATE bucket with its OWN keys (never the keys of the files bucket).
BACKUP_S3_ENDPOINT=https://fsn1.your-objectstorage.com
BACKUP_S3_REGION=fsn1
BACKUP_S3_BUCKET=my-app-backups
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=

# Optional: a Healthchecks.io ping URL. backup.sh pings it after every good backup, and
# Healthchecks emails you when the ping is missing ("the backup did not run").
HEALTHCHECK_URL=
